<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="MainWindow.Title">ソニアド2 メッセージテキストエディター</system:String>

    <!-- Menu -->
    <system:String x:Key="Menu.File">ファイル(_F)</system:String>
    <system:String x:Key="Menu.Search">検索(_S)</system:String>
    <system:String x:Key="Menu.Settings">設定(_S)</system:String>
    <system:String x:Key="Menu.Language">言語(_L)</system:String>

    <system:String x:Key="Menu.File.Open">開く...</system:String>
    <system:String x:Key="Menu.File.Save">保存</system:String>
    <system:String x:Key="Menu.File.SaveAs">名前を付けて保存...</system:String>
    <system:String x:Key="Menu.File.ImportJson">JSONをインポート...</system:String>
    <system:String x:Key="Menu.File.ExportJson">JSONをエクスポート...</system:String>
    <system:String x:Key="Menu.File.Exit">終了</system:String>

    <system:String x:Key="Menu.Search.Find">検索...</system:String>

    <system:String x:Key="Menu.Settings.Codepage">コードページ</system:String>
    <system:String x:Key="Codepage.Latin">ラテン文字 (Windows-1252)</system:String>
    <system:String x:Key="Codepage.Cyrillic">キリル文字 (Windows-1251)</system:String>
    <system:String x:Key="Codepage.Japanese">日本文字 (Shift-JIS)</system:String>
    <system:String x:Key="Menu.Codepage.Custom">カスタム...</system:String>
    <system:String x:Key="Menu.Settings.Endianness">エンディアン</system:String>
    <system:String x:Key="Menu.Endianness.Auto">オート</system:String>
    <system:String x:Key="Menu.Endianness.BigEndian">ビッグエンディアン (Big Endian)</system:String>
    <system:String x:Key="Menu.Endianness.LittleEndian">リトルエンディアン (Little Endian)</system:String>

    <system:String x:Key="Language.English">English (英語)</system:String>
    <system:String x:Key="Language.Russian">Русский (ロシア語)</system:String>
    <system:String x:Key="Language.Japanese">日本語</system:String>

    <!-- File filters -->
    <system:String x:Key="Filters.PRS">
		サポートされているファイル|eh*.prs;mh*.prs;ex_mission?.prs;mission?.prs;msg*.prs;text_?.prs;mcwarn_?.prs;msgalkinderfoname_?.prs
		|宝探しヒントファイル|eh*.prs
		|ゲームプレイメッセージファイル|mh*.prs
		|他のメッセージファイル|ex_mission?.prs;mission?.prs;msg*.prs;text_?.prs;mcwarn_?.prs"
		|チャオ名ファイル|msgalkinderfoname_?.prs
		|全てのPRSファイル|*.prs
	</system:String>
    <system:String x:Key="Filters.JSON">JSONファイル|*.json</system:String>

    <!-- Custom codepage input -->
    <system:String x:Key="EnterCustomCodepage.Title">コードページ</system:String>
    <system:String x:Key="EnterCustomCodepage.Text">カスタムコードページを入力してください</system:String>
    <system:String x:Key="EnterCustomCodepage.OK">OK</system:String>
    <system:String x:Key="EnterCustomCodepage.Cancel">キャンセル</system:String>

    <!-- Search window -->
    <system:String x:Key="Search.Title">検索</system:String>
    <system:String x:Key="Search.FindWhat">検索文字列:</system:String>
    <system:String x:Key="Search.Results">検索リザルト</system:String>
    <system:String x:Key="Search.ResultsCount">リザルト数:</system:String>
    <system:String x:Key="Search.IgnoreCase">大／小文字を区別しない</system:String>

    <!-- Status bar -->
    <system:String x:Key="Status.FileType.HuntingHints">宝探しヒント</system:String>
    <system:String x:Key="Status.FileType.GameplayMessages">オモチャオのヒント／ゲームプレイメッセージ</system:String>
    <system:String x:Key="Status.FileType.SimpleText">シンプルなテキスト配列</system:String>
    <system:String x:Key="Status.FileType.ChaoNames">チャオ名</system:String>
    <system:String x:Key="Status.SelectedGroup">選択されたグループ</system:String>
    <system:String x:Key="Status.SelectedItem">選択されたアイテム</system:String>
    <system:String x:Key="Status.SelectedItem.None">選択されたアイテム: なし</system:String>
	<system:String x:Key="Status.TotalItems">アイテム数</system:String>
    <system:String x:Key="Status.Endianness.Auto">オート</system:String>
    <system:String x:Key="Status.Endianness.BigEndian">Big Endian</system:String>
    <system:String x:Key="Status.Endianness.LittleEndian">Little Endian</system:String>    
    <system:String x:Key="Status.CustomCodepage">カスタムコードページ</system:String>

    <!-- List box -->
    <system:String x:Key="ListBox.EmptyString">{なし}</system:String>

    <!-- Messages list -->
    <system:String x:Key="SA2Message.Voice">音声</system:String>
    <system:String x:Key="SA2Message.FrameCount">タイム</system:String>
    <system:String x:Key="SA2Message.Is2P">2P</system:String>
    <system:String x:Key="SA2Message.TextCentering">中央</system:String>
    <system:String x:Key="SA2Message.Text">テキスト</system:String>
    <system:String x:Key="SA2Message.ChaoNames">チャオ名</system:String>

    <system:String x:Key="SA2Message.Voice.Description">音声ID</system:String>
    <system:String x:Key="SA2Message.FrameCount.Description">表示期間 （フレーム数）</system:String>
    <system:String x:Key="SA2Message.Is2P.Description">2人用の宝探しモードフラグ</system:String>
    <system:String x:Key="SA2Message.TextCentering.Description">テキストの中央揃えの方法</system:String>
    <system:String x:Key="SA2Message.Text.Description">字幕のテキスト</system:String>
    <system:String x:Key="SA2Message.ChaoNames.Description">チャオの名前（7つの文字以内）</system:String>

    <!-- Text centering options-->
    <system:String x:Key="TextCentering.None">なし</system:String>
    <system:String x:Key="TextCentering.Block">ブロック</system:String>
    <system:String x:Key="TextCentering.All">全部</system:String>

    <system:String x:Key="TextCentering.None.Description">中央揃えなし、左揃え</system:String>
    <system:String x:Key="TextCentering.Block.Description">テキストブロック：中央揃え、中のテキスト：左揃え</system:String>
    <system:String x:Key="TextCentering.All.Description">全てのテキスト：中央揃え</system:String>

    <!-- Buttons -->
    <system:String x:Key="Button.Add">追加</system:String>
    <system:String x:Key="Button.InsertAfter">後に挿入</system:String>
    <system:String x:Key="Button.RemoveLast">最後を削除</system:String>
    <system:String x:Key="Button.RemoveSelected">選択されたアイテムを削除</system:String>
    <system:String x:Key="Button.Find">検索</system:String>
    <system:String x:Key="Button.Close">閉じる</system:String>

    <!-- Message boxes -->
    <system:String x:Key="Message.FileOpenOnClosing" xml:space="preserve">開いているファイルがあります。&#x0a;保存されていない変更は失われます。&#x0a;&#x0a;終了しますか？</system:String>
    <system:String x:Key="Message.FileOpenOnOpeningNewFile" xml:space="preserve">開いているファイルがあります。&#x0a;保存されていない変更は失われます。&#x0a;&#x0a;新しいファイルは開きますか？</system:String>
    <system:String x:Key="Message.WrongEndianness" xml:space="preserve">エンディアン設定がファイルと一致していないようです。&#x0a;&#x0a;エンディアン設定を変えてみます。</system:String>
    <system:String x:Key="Message.AutoEndiannessSaveAs" xml:space="preserve">オートエンディアンでインポートされたJSONファイルから&#x0a;PRSファイルを保存できません。&#x0a;&#x0a;Big endianかLittle endianが設定してください。</system:String>
    <system:String x:Key="Message.UnsupportedCodepage" xml:space="preserve">入力されたコードページはサポートされていません。</system:String>
    <system:String x:Key="Message.InvalidJson" xml:space="preserve">インポートされたJSONファイルに&#x0a;ゲームのメッセージデータがありません。</system:String>
    <system:String x:Key="Message.NothingFound" xml:space="preserve">検索リザルトなし。</system:String>
</ResourceDictionary>