<Window x:Name="WindowTextEditor" x:Class="SA2EventTextEditor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:common="clr-namespace:SA2EventTextEditor.Common"
        xmlns:ui="clr-namespace:SA2EventTextEditor.UI"
        mc:Ignorable="d"
        Title="{DynamicResource MainWindow.Title}"
        Width="960" MinWidth="800"
        Height="720" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Loaded="WindowTextEditor_Loaded"
        Closing="WindowTextEditor_Closing">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="2"/>
                </Style>
            </Style.Resources>

            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="25" />
            <Setter Property="BorderBrush" Value="DarkGray" />
        </Style>
    </Window.Resources>
    
    <Window.CommandBindings>
        <CommandBinding x:Name="CommandOpen" Command="Open" Executed="CommandOpen_Executed" />
        <CommandBinding x:Name="CommandSave" Command="Save" Executed="CommandSave_Executed" />
        <CommandBinding x:Name="CommandSaveAs" Command="SaveAs" Executed="CommandSaveAs_Executed" />
        <CommandBinding x:Name="CommandClose" Command="Close" Executed="CommandClose_Executed" />
        <CommandBinding x:Name="CommandSearch" Command="Search" Executed="CommandSearch_Executed" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="Open" />
        <KeyBinding Gesture="Ctrl+S" Command="Save" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="SaveAs" />
        <KeyBinding Gesture="Ctrl+F" Command="Search" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu x:Name="Menu" Grid.Row="0" Height="25" VerticalAlignment="Top" FontSize="14">
            <MenuItem Header="{DynamicResource Menu.File}">
                <MenuItem Name="MenuOpenFile" Header="{DynamicResource Menu.File.Open}" InputGestureText="Ctrl+O" Command="Open" />
                <Separator />
                <MenuItem Name="MenuSave" Header="{DynamicResource Menu.File.Save}" InputGestureText="Ctrl+S" Command="Save" />
                <MenuItem Name="MenuSaveAs" Header="{DynamicResource Menu.File.SaveAs}" InputGestureText="Ctrl+Shift+S" Command="SaveAs" />
                <Separator />
                <MenuItem Name="MenuImportJson" Header="{DynamicResource Menu.File.ImportJson}" Click="MenuImportJson_Click" />
                <MenuItem Name="MenuExportJson" Header="{DynamicResource Menu.File.ExportJson}" Click="MenuExportJson_Click" />
                <Separator />
                <MenuItem Name="MenuExit" Header="{DynamicResource Menu.File.Exit}" InputGestureText="Alt+F4" Command="Close" />
            </MenuItem>

            <MenuItem x:Name="MenuSearch" Header="{DynamicResource Menu.Search}">
                <MenuItem x:Name="MenuFind" Header="{DynamicResource Menu.Search.Find}" InputGestureText="Ctrl+F" Command="Search" />
            </MenuItem>

            <MenuItem Header="{DynamicResource Menu.Settings}">
                <MenuItem Header="{DynamicResource Menu.Settings.Codepage}">
                    <MenuItem x:Name="Codepage1252" Header="{DynamicResource Codepage.Latin}" IsCheckable="True" Click="Codepage1252_Click" />
                    <MenuItem x:Name="Codepage1251" Header="{DynamicResource Codepage.Cyrillic}" IsCheckable="True" Click="Codepage1251_Click" />
                    <MenuItem x:Name="CodepageSJIS" Header="{DynamicResource Codepage.Japanese}" IsCheckable="True" Click="CodepageSJIS_Click" />
                    <MenuItem x:Name="CodepageCustom" Header="{DynamicResource Menu.Codepage.Custom}" IsCheckable="True" Click="CodepageCustom_Click" />
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Settings.Endianness}">
                    <MenuItem x:Name="AutoEndian" Header="{DynamicResource Menu.Endianness.Auto}" IsCheckable="True" Click="AutoEndian_Click" />
                    <MenuItem x:Name="BigEndian" Header="{DynamicResource Menu.Endianness.BigEndian}" IsCheckable="True" Click="BigEndian_Click" />
                    <MenuItem x:Name="LittleEndian" Header="{DynamicResource Menu.Endianness.LittleEndian}" IsCheckable="True" Click="LittleEndian_Click" />
                </MenuItem>
            </MenuItem>
            
            <MenuItem Header="{DynamicResource Menu.Language}">
                <MenuItem x:Name="MenuEnglish" Header="{DynamicResource Language.English}" IsCheckable="True" Click="MenuEnglish_Click" />
                <MenuItem x:Name="MenuRussian" Header="{DynamicResource Language.Russian}" IsCheckable="True" Click="MenuRussian_Click" />
                <MenuItem x:Name="MenuJapanese" Header="{DynamicResource Language.Japanese}" IsCheckable="True" Click="MenuJapanese_Click" />
            </MenuItem>            
        </Menu>

        <!-- Main contents -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Event IDs-->
            <ListBox x:Name="Events" Grid.Column="0" Width="320" Margin="10" HorizontalAlignment="Left" BorderBrush="LightGray" SelectionChanged="Events_SelectionChanged">
                <ListBox.Resources>
                    <common:SA2EventNamesConverter x:Key="EventNamesConverter" />

                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="3"/>
                    </Style>
                </ListBox.Resources>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding EventID, Converter={StaticResource EventNamesConverter}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Messages list for selected event ID and buttons -->
            <Grid x:Name="GridMessagesList" Grid.Column="1">
                <Grid.RowDefinitions>                    
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- Messages list -->
                <DataGrid x:Name="EventMessages" Grid.Row="0" FontSize="14" Margin="10" AutoGenerateColumns="False" VerticalAlignment="Top" CanUserAddRows="False" HeadersVisibility="Column"
                          BorderBrush="LightGray" HorizontalGridLinesBrush="LightGray" VerticalGridLinesBrush="LightGray" SelectionChanged="EventMessages_SelectionChanged">

                    <DataGrid.Resources>
                        <common:TextCenteringNameConverter x:Key="TextCenteringNameConverter" />
                        <common:TextCenteringDescriptionConverter x:Key="TextCenteringDescriptionConverter" />

                        <ObjectDataProvider x:Key="TextCenteringEnumValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                            <ObjectDataProvider.MethodParameters>
                                <x:Type TypeName="common:TextCentering" />
                            </ObjectDataProvider.MethodParameters>
                        </ObjectDataProvider>

                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3" />
                        </Style>
                        <Style x:Key="CenteredHeader" TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                        <Style x:Key="NumericTextAlignment" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <Style x:Key="NumericBoxAlignment" TargetType="TextBox">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                        <Style x:Key="TextAlignment" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <Style x:Key="AcceptLineBreak" TargetType="TextBox">
                            <Setter Property="AcceptsReturn" Value="True" />
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="LightGray" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>                        
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="DodgerBlue" />
                                    <Setter Property="BorderBrush" Value="SteelBlue" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>                        
                        <!-- Character -->
                        <ui:DataGridNumericColumn
                            MinWidth="30" MaxWidth="150" CanUserSort="False"
                            Binding="{Binding Character, UpdateSourceTrigger=PropertyChanged, TargetNullValue={x:Static sys:String.Empty}}"
                            HeaderStyle="{StaticResource CenteredHeader}"
                            ElementStyle="{StaticResource NumericTextAlignment}"
                            EditingElementStyle="{StaticResource NumericBoxAlignment}">
                            <ui:DataGridNumericColumn.Header>
                                <TextBlock Text="{DynamicResource Character}" ToolTip="{DynamicResource Character.Description}" />
                            </ui:DataGridNumericColumn.Header>
                        </ui:DataGridNumericColumn>

                        <!-- Text centering -->
                        <DataGridTemplateColumn MinWidth="50" MaxWidth="150" CanUserSort="False" HeaderStyle="{StaticResource CenteredHeader}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource TextCentering}" ToolTip="{DynamicResource TextCentering.Description}" />
                            </DataGridTemplateColumn.Header>
                            
                            <DataGridTemplateColumn.CellTemplate>                                
                                <DataTemplate>
                                    <TextBlock                                        
                                        Padding="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Text="{Binding TextCentering, Converter={StaticResource TextCenteringNameConverter}}"
                                        ToolTip="{Binding TextCentering, Converter={StaticResource TextCenteringDescriptionConverter}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        Padding="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ItemsSource="{Binding Source={StaticResource TextCenteringEnumValues}, Mode=OneWay}"
                                        SelectedItem="{Binding TextCentering, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Text="{Binding Converter={StaticResource TextCenteringNameConverter}}"
                                                    ToolTip="{Binding Converter={StaticResource TextCenteringDescriptionConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- Text -->
                        <DataGridTextColumn
                            Width="*" MinWidth="320" CanUserSort="False"
                            Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                            ElementStyle="{StaticResource TextAlignment}"
                            EditingElementStyle="{StaticResource AcceptLineBreak}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Text}" ToolTip="{DynamicResource Text.Description}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Buttons -->
                <Grid Grid.Row="1" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Right">
                        <Button x:Name="ButtonAdd" Content="{DynamicResource Button.Add}" Click="ButtonAdd_Click" />
                        <Button x:Name="ButtonInsertAfter" Content="{DynamicResource Button.InsertAfter}" Margin="0,15,0,0" IsEnabled="False" Click="ButtonInsertAfter_Click" />                        
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" Margin="15,0,0,0">
                        <Button x:Name="ButtonRemoveLast" Content="{DynamicResource Button.RemoveLast}" Click="ButtonRemoveLast_Click" />
                        <Button x:Name="ButtonRemoveSelected" Content="{DynamicResource Button.RemoveSelected}" Margin="0,15,0,0" IsEnabled="False" Click="ButtonRemoveSelected_Click" />
                    </StackPanel>
                </Grid>                
            </Grid>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="2" Height="25" BorderBrush="LightGray" BorderThickness="1">
            <StatusBar.Resources>
                <Style x:Key="StatusBarSeparator" TargetType="Separator">
                    <Setter Property="BorderBrush" Value="LightGray" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="DockPanel.Dock" Value="Right" />
                </Style>
            </StatusBar.Resources>

            <!-- Config items -->
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="StatusEncoding" />
            </StatusBarItem>
            <Separator Style="{StaticResource StatusBarSeparator}" />
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="StatusEndianness" />
            </StatusBarItem>
            <Separator Style="{StaticResource StatusBarSeparator}" />
            
            <!-- Details -->
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="StatusTotalItems" />
            </StatusBarItem>
            <Separator x:Name="StatusSeparator1" Style="{StaticResource StatusBarSeparator}" />
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="StatusSelectedItem" />
            </StatusBarItem>
            <Separator x:Name="StatusSeparator2" Style="{StaticResource StatusBarSeparator}" />
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="StatusEventID" />
            </StatusBarItem>
            <Separator x:Name="StatusSeparator3" Style="{StaticResource StatusBarSeparator}" />

            <!-- Mode (prs/json) -->
            <StatusBarItem>
                <TextBlock x:Name="StatusMode" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
