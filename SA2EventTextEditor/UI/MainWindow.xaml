<Window x:Name="WindowTextEditor" x:Class="SA2EventTextEditor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:common="clr-namespace:SA2EventTextEditor.Common"
        xmlns:behaviors="clr-namespace:SA2EventTextEditor.UI.Behaviors"
        xmlns:converters="clr-namespace:SA2EventTextEditor.UI.Converters"
        xmlns:uielements="clr-namespace:SA2EventTextEditor.UI.Elements"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="960" MinWidth="800"
        Height="720" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Loaded="WindowTextEditor_Loaded"
        Closing="WindowTextEditor_Closing">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="25" />
            <Setter Property="BorderBrush" Value="DarkGray" />
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="2"/>
                </Style>                
            </Style.Resources>            
        </Style>
        
        <Style TargetType="DataGrid">            
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="LightGray" />
            <Setter Property="HorizontalGridLinesBrush" Value="LightGray" />
            <Setter Property="VerticalGridLinesBrush" Value="LightGray" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="3" />
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>
    
    <Window.CommandBindings>
        <CommandBinding x:Name="CommandOpen" Command="Open" Executed="CommandOpen_Executed" />
        <CommandBinding x:Name="CommandSave" Command="Save" Executed="CommandSave_Executed" />
        <CommandBinding x:Name="CommandSaveAs" Command="SaveAs" Executed="CommandSaveAs_Executed" />
        <CommandBinding x:Name="CommandClose" Command="Close" Executed="CommandClose_Executed" />
        <CommandBinding x:Name="CommandSearch" Command="Search" Executed="CommandSearch_Executed" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="Open" />
        <KeyBinding Gesture="Ctrl+S" Command="Save" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="SaveAs" />
        <KeyBinding Gesture="Ctrl+F" Command="Search" />
    </Window.InputBindings>

    <!-- Editor -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </Grid.Resources>

        <!-- Menu -->
        <Menu x:Name="Menu" Grid.Row="0" Height="25" VerticalAlignment="Top" FontSize="14">
            <Menu.Resources>
                <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            </Menu.Resources>
            
            <MenuItem Header="{DynamicResource Menu.File}">
                <MenuItem Name="MenuOpenFile" Header="{DynamicResource Menu.File.Open}" InputGestureText="Ctrl+O" Command="Open" />
                <Separator />
                <MenuItem Name="MenuSave" Header="{DynamicResource Menu.File.Save}" IsEnabled="{Binding IsPRS}" InputGestureText="Ctrl+S" Command="Save" />
                <MenuItem Name="MenuSaveAs" Header="{DynamicResource Menu.File.SaveAs}" IsEnabled="{Binding EventFileLoaded}" InputGestureText="Ctrl+Shift+S" Command="SaveAs" />
                <Separator />
                <MenuItem Name="MenuImportJson" Header="{DynamicResource Menu.File.ImportJson}" Click="MenuImportJson_Click" />
                <MenuItem Name="MenuExportJson" Header="{DynamicResource Menu.File.ExportJson}" IsEnabled="{Binding EventFileLoaded}" Click="MenuExportJson_Click" />
                <Separator />
                <MenuItem Name="MenuExit" Header="{DynamicResource Menu.File.Exit}" InputGestureText="Alt+F4" Command="Close" />
            </MenuItem>

            <MenuItem x:Name="MenuSearch" Header="{DynamicResource Menu.Search}" IsEnabled="{Binding EventFileLoaded}">
                <MenuItem x:Name="MenuFind" Header="{DynamicResource Menu.Search.Find}" InputGestureText="Ctrl+F" Command="Search" />
            </MenuItem>

            <MenuItem Header="{DynamicResource Menu.Settings}">
                <MenuItem Header="{DynamicResource Menu.Settings.Codepage}">
                    <MenuItem x:Name="Codepage1252" Header="{DynamicResource Codepage.Latin}" IsCheckable="True" Click="Codepage1252_Click" />
                    <MenuItem x:Name="Codepage1251" Header="{DynamicResource Codepage.Cyrillic}" IsCheckable="True" Click="Codepage1251_Click" />
                    <MenuItem x:Name="CodepageSJIS" Header="{DynamicResource Codepage.Japanese}" IsCheckable="True" Click="CodepageSJIS_Click" />
                    <MenuItem x:Name="CodepageCustom" Header="{DynamicResource Menu.Codepage.Custom}" IsCheckable="True" Click="CodepageCustom_Click" />
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Settings.Endianness}">
                    <MenuItem x:Name="AutoEndian" Header="{DynamicResource Menu.Endianness.Auto}" IsEnabled="{Binding EventFileLoaded, Converter={StaticResource InverseBoolConverter}}" IsCheckable="True" Click="AutoEndian_Click" />
                    <MenuItem x:Name="BigEndian" Header="{DynamicResource Menu.Endianness.BigEndian}" IsCheckable="True" Click="BigEndian_Click" />
                    <MenuItem x:Name="LittleEndian" Header="{DynamicResource Menu.Endianness.LittleEndian}" IsCheckable="True" Click="LittleEndian_Click" />
                </MenuItem>
            </MenuItem>
            
            <MenuItem Header="{DynamicResource Menu.Language}">
                <MenuItem x:Name="MenuEnglish" Header="{DynamicResource Language.English}" IsCheckable="True" Click="MenuEnglish_Click" />
                <MenuItem x:Name="MenuRussian" Header="{DynamicResource Language.Russian}" IsCheckable="True" Click="MenuRussian_Click" />
                <MenuItem x:Name="MenuJapanese" Header="{DynamicResource Language.Japanese}" IsCheckable="True" Click="MenuJapanese_Click" />
            </MenuItem>            
        </Menu>

        <!-- Main contents -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.6*" />
            </Grid.ColumnDefinitions>

            <!-- Event list-->
            <GroupBox Grid.Column="0" x:Name="GroupEvents" Visibility="{Binding EventFileLoaded, Converter={StaticResource BoolToVisibilityConverter}}" BorderBrush="LightGray" Margin="10">
                <GroupBox.Header>
                    <TextBlock Text="{DynamicResource Editor.EventList}" FontWeight="DemiBold" />
                </GroupBox.Header>
                
                <GroupBox.Resources>
                    <converters:SA2EventNamesConverter x:Key="EventNamesConverter" />

                    <CollectionViewSource Source="{Binding EventFile.Events}" x:Key="SortByEventID">
                        <CollectionViewSource.SortDescriptions>
                            <scm:SortDescription PropertyName="EventID" />
                        </CollectionViewSource.SortDescriptions>
                    </CollectionViewSource>
                </GroupBox.Resources>

                <ListBox x:Name="Events" ItemsSource="{Binding Source={StaticResource SortByEventID}}" SelectedItem="{Binding SelectedScene}" Margin="10" BorderBrush="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding EventID, Converter={StaticResource EventNamesConverter}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <i:Interaction.Behaviors>
                        <behaviors:ListBoxScrollIntoView />
                    </i:Interaction.Behaviors>
                </ListBox>
            </GroupBox>

            <!-- Messages list for selected event ID and buttons -->
            <GroupBox Grid.Column="1" x:Name="GroupMessages" Visibility="{Binding AnySceneIsSelected, Converter={StaticResource BoolToVisibilityConverter}}" BorderBrush="LightGray" Margin="10">
                <GroupBox.Header>
                    <TextBlock Text="{DynamicResource Editor.MessageList}" FontWeight="DemiBold" />
                </GroupBox.Header>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Messages list -->
                    <DataGrid Grid.Row="0" x:Name="EventMessages" ItemsSource="{Binding SelectedScene.Messages}" SelectedIndex="{Binding SelectedMessageIndex}" Margin="10">

                        <DataGrid.Resources>
                            <converters:TextCenteringNameConverter x:Key="TextCenteringNameConverter" />
                            <converters:TextCenteringDescriptionConverter x:Key="TextCenteringDescriptionConverter" />

                            <ObjectDataProvider x:Key="TextCenteringEnumValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                                <ObjectDataProvider.MethodParameters>
                                    <x:Type TypeName="common:TextCentering" />
                                </ObjectDataProvider.MethodParameters>
                            </ObjectDataProvider>
                            
                            <Style x:Key="CenteredHeader" TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="NumericTextAlignment" TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="NumericBoxAlignment" TargetType="TextBox">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="TextAlignment" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="AcceptLineBreak" TargetType="TextBox">
                                <Setter Property="AcceptsReturn" Value="True" />
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="DodgerBlue" />
                                        <Setter Property="BorderBrush" Value="SteelBlue" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <i:Interaction.Behaviors>
                            <behaviors:DataGridScrollIntoView />
                        </i:Interaction.Behaviors>

                        <DataGrid.Columns>
                            <!-- Character -->
                            <uielements:DataGridNumericColumn Binding="{Binding Character, UpdateSourceTrigger=PropertyChanged, TargetNullValue={x:Static sys:String.Empty}}"
                                                              HeaderStyle="{StaticResource CenteredHeader}"
                                                              ElementStyle="{StaticResource NumericTextAlignment}"
                                                              EditingElementStyle="{StaticResource NumericBoxAlignment}"
                                                              MinWidth="30" MaxWidth="150" CanUserSort="False">
                                <uielements:DataGridNumericColumn.Header>
                                    <TextBlock Text="{DynamicResource Character}" ToolTip="{DynamicResource Character.Description}" FontWeight="DemiBold" />
                                </uielements:DataGridNumericColumn.Header>
                            </uielements:DataGridNumericColumn>

                            <!-- Text centering -->
                            <DataGridTemplateColumn MinWidth="50" MaxWidth="150" CanUserSort="False" HeaderStyle="{StaticResource CenteredHeader}">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{DynamicResource TextCentering}" ToolTip="{DynamicResource TextCentering.Description}" FontWeight="DemiBold" />
                                </DataGridTemplateColumn.Header>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TextCentering, Converter={StaticResource TextCenteringNameConverter}}"
                                                   ToolTip="{Binding TextCentering, Converter={StaticResource TextCenteringDescriptionConverter}}"
                                                   Padding="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={StaticResource TextCenteringEnumValues}, Mode=OneWay}"
                                                  SelectedItem="{Binding TextCentering, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  Padding="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource TextCenteringNameConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource TextCenteringDescriptionConverter}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Text -->
                            <DataGridTextColumn Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource TextAlignment}"
                                                EditingElementStyle="{StaticResource AcceptLineBreak}"
                                                Width="*" MinWidth="320" CanUserSort="False">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Text}" ToolTip="{DynamicResource Text.Description}" FontWeight="DemiBold" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Buttons -->
                    <Grid Grid.Row="1" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Right">
                            <Button x:Name="ButtonAdd" Content="{DynamicResource Button.Add}" Click="ButtonAdd_Click" />
                            <Button x:Name="ButtonInsertAfter" Content="{DynamicResource Button.InsertAfter}" IsEnabled="{Binding AnyMessageIsSelected}" Margin="0,15,0,0" Click="ButtonInsertAfter_Click" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" Margin="15,0,0,0">
                            <Button x:Name="ButtonRemoveLast" Content="{DynamicResource Button.RemoveLast}" Click="ButtonRemoveLast_Click" />
                            <Button x:Name="ButtonRemoveSelected" Content="{DynamicResource Button.RemoveSelected}" IsEnabled="{Binding AnyMessageIsSelected}" Margin="0,15,0,0" Click="ButtonRemoveSelected_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="2" Height="25" BorderBrush="LightGray" BorderThickness="1">
            <StatusBar.Resources>
                <Style x:Key="StatusBarSeparator" TargetType="Separator">
                    <Setter Property="BorderBrush" Value="DarkGray" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="LayoutTransform">
                        <Setter.Value>
                            <RotateTransform Angle="90" />
                        </Setter.Value>
                    </Setter>
                </Style>
            </StatusBar.Resources>

            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- Mode (prs/json) -->
            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="StatusMode" Text="{Binding FileModeAsString}" />
            </StatusBarItem>
            
            <!-- Details -->
            <StatusBarItem Grid.Column="1" x:Name="StatusDetails" Visibility="{Binding AnySceneIsSelected, Converter={StaticResource BoolToVisibilityConverter}}" Padding="0">
                <StackPanel Orientation="Horizontal">
                    <Separator Style="{StaticResource StatusBarSeparator}" />
                    
                    <!-- Event ID -->
                    <StatusBarItem>
                        <TextBlock x:Name="StatusEventID" Text="{DynamicResource Status.EventID}" />
                    </StatusBarItem>
                    <StatusBarItem>
                        <TextBlock x:Name="StatusEventIDValue" Text="{Binding SelectedScene.EventID, FallbackValue='none'}" />
                    </StatusBarItem>

                    <Separator Style="{StaticResource StatusBarSeparator}" />

                    <!-- Selected item -->
                    <StatusBarItem>
                        <TextBlock x:Name="StatusSelectedItem" Text="{DynamicResource Status.SelectedItem}" />
                    </StatusBarItem>
                    <StatusBarItem>
                        <TextBlock x:Name="StatusSelectedItemValue" Text="{Binding SelectedMessageIndexAsString, FallbackValue='none'}" />
                    </StatusBarItem>

                    <Separator Style="{StaticResource StatusBarSeparator}" />

                    <!-- Total items -->
                    <StatusBarItem>
                        <TextBlock x:Name="StatusTotalItems" Text="{DynamicResource Status.TotalItems}" />
                    </StatusBarItem>
                    <StatusBarItem>
                        <TextBlock x:Name="StatusTotalItemsValue" Text="{Binding SelectedScene.Messages.Count, FallbackValue=0}" />
                    </StatusBarItem>
                </StackPanel>
            </StatusBarItem>

            <!-- Config items -->
            <StatusBarItem Grid.Column="2" Padding="0">
                <StackPanel Orientation="Horizontal">
                    <Separator Style="{StaticResource StatusBarSeparator}" />

                    <!-- Endianness -->
                    <StatusBarItem>
                        <TextBlock x:Name="StatusEndianness" Text="{Binding EndiannessAsString}" ToolTip="{DynamicResource Menu.Settings.Endianness}" />
                    </StatusBarItem>

                    <Separator Style="{StaticResource StatusBarSeparator}" />

                    <!-- Encoding -->
                    <StatusBarItem>
                        <TextBlock x:Name="StatusEncoding" Text="{Binding EncodingAsString}" ToolTip="{DynamicResource Menu.Settings.Codepage}" />
                    </StatusBarItem>
                </StackPanel>
            </StatusBarItem>            
        </StatusBar>
    </Grid>
</Window>
