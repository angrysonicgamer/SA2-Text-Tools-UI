<Window x:Name="WindowCustomCodepage" x:Class="SA2EventTextEditor.UI.CustomCodepageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uielements="clr-namespace:SA2EventTextEditor.UI.Elements"
        mc:Ignorable="d"
        Title="{DynamicResource EnterCustomCodepage.Title}"
        Width="240" Height="180"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="WindowCustomCodepage_Loaded">

    <Window.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="2"/>
                </Style>
            </Style.Resources>

            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="25" />
            <Setter Property="BorderBrush" Value="DarkGray" />
        </Style>
        <Style TargetType="uielements:NumericTextBox">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="2" />
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <GroupBox Header="{DynamicResource EnterCustomCodepage.Text}" Margin="10">
        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
            <uielements:NumericTextBox x:Name="CustomCodepage" FontSize="14" Width="120" Height="25" TextAlignment="Center" VerticalContentAlignment="Center" KeyUp="CustomCodepage_KeyUp" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="ButtonOK" Content="{DynamicResource EnterCustomCodepage.OK}" Width="70" Margin="0,0,20,0" Click="ButtonOK_Click" />
                <Button x:Name="ButtonCancel" Content="{DynamicResource EnterCustomCodepage.Cancel}" Width="70" Click="ButtonCancel_Click" />
            </StackPanel>
        </StackPanel>
    </GroupBox>
</Window>
